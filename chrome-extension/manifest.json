{
  "manifest_version": 3,
  "name": "LectureLens AI",
  "version": "1.0",
  "description": "Ask questions about YouTube lectures",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}